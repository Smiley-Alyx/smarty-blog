#!/usr/bin/env php
<?php

declare(strict_types=1);

$command = $argv[1] ?? null;

if ($command === 'seed') {
    require __DIR__ . '/bootstrap/seed.php';
    exit(0);
}

if ($command === 'build-css') {
    $script = __DIR__ . '/scripts/build-css.sh';
    passthru('sh ' . escapeshellarg($script), $exitCode);
    exit($exitCode);
}

fwrite(STDERR, "Unknown command.\n");
fwrite(STDERR, "Usage:\n");
fwrite(STDERR, "  php cli seed\n");
fwrite(STDERR, "  php cli build-css\n");
exit(1);
